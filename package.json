{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "server:dev": "node server/index.js",
    "build": "vite build",
    "build:server": "cd server && pnpm install && npx prisma generate",
    "build:all": "vite build && cd server && pnpm install && npx prisma db push && npx prisma generate",
    "start": "node server/index.js",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "devtools-detector": "^2.0.25",
    "hls.js": "^1.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
